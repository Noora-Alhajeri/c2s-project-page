<!--
  C→S Teaser Diagram
  ──────────────────────────────────────────────────────────────────────
  Visual narrative: "The robot starts as a slow deliberate novice (left)
  and, after ~40 episodes of practice, compiles its skills into fast
  automatic execution (right)."

  Layout (960 × 380):
    LEFT  (0–300)    — Conscious mode:  structured brain, slow, deliberate
    CENTER (300–660) — Transformation:  arrow, 3.83×, three brain layers
    RIGHT (660–960)  — Subconscious mode: wave brain, fast, automatic

  Colors are INTENTIONAL:
    Indigo  #6366f1 = Semantic / Neocortex  = deliberate thought
    Violet  #8b5cf6 = Episodic / Limbic sys = memory
    Emerald #10b981 = Procedural / Reptilian= reflex / habit
    Slate   #1e293b = ink on paper
    Warm    #fafaf7 = notebook paper background
  ──────────────────────────────────────────────────────────────────────
-->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 380" fill="none"
     role="img" aria-label="C to S transformation diagram">
  <defs>

    <!-- Hand-drawn wobble for sketch feel -->
    <filter id="sk" x="-8%" y="-8%" width="116%" height="116%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035"
                    numOctaves="3" seed="5" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"
                         xChannelSelector="R" yChannelSelector="G"/>
    </filter>

    <!-- Lighter wobble for text/numbers -->
    <filter id="sk2" x="-4%" y="-4%" width="108%" height="108%">
      <feTurbulence type="fractalNoise" baseFrequency="0.03"
                    numOctaves="2" seed="11" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="1.2"
                         xChannelSelector="R" yChannelSelector="G"/>
    </filter>

    <!-- Brain mask for left conscious brain -->
    <mask id="bl">
      <ellipse cx="150" cy="190" rx="85" ry="95" fill="white"/>
    </mask>

    <!-- Brain mask for right subconscious brain -->
    <mask id="br">
      <ellipse cx="810" cy="190" rx="85" ry="95" fill="white"/>
    </mask>

  </defs>

  <!-- ══════════════════════════════════════════════
       BACKGROUND — warm notebook paper
       ══════════════════════════════════════════════ -->
  <rect width="960" height="380" fill="#fafaf7" rx="18"/>

  <!-- Subtle ruled lines (notebook paper feel) -->
  <g opacity="0.18">
    <line x1="0" y1="48"  x2="960" y2="48"  stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="80"  x2="960" y2="80"  stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="112" x2="960" y2="112" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="144" x2="960" y2="144" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="176" x2="960" y2="176" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="208" x2="960" y2="208" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="240" x2="960" y2="240" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="272" x2="960" y2="272" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="304" x2="960" y2="304" stroke="#c9c0b4" stroke-width="1"/>
    <line x1="0" y1="336" x2="960" y2="336" stroke="#c9c0b4" stroke-width="1"/>
  </g>


  <!-- ══════════════════════════════════════════════
       LEFT SIDE — CONSCIOUS (C)
       Three color zones + structured grid lines
       = deliberate, step-by-step thought
       ══════════════════════════════════════════════ -->

  <!-- Three brain-layer color zones, masked to ellipse -->
  <g mask="url(#bl)">
    <rect x="65"  y="95"  width="170" height="65"  fill="#ede9fe"/><!-- indigo: neocortex -->
    <rect x="65"  y="160" width="170" height="50"  fill="#f3e8ff"/><!-- violet: limbic -->
    <rect x="65"  y="210" width="170" height="80"  fill="#d1fae5"/><!-- emerald: reptilian -->

    <!-- Structured GRID lines — represents conscious deliberation -->
    <g filter="url(#sk)" opacity="0.55">
      <!-- Horizontal rules (neocortex zone) -->
      <line x1="70" y1="113" x2="227" y2="113" stroke="#6366f1" stroke-width="1.3"/>
      <line x1="70" y1="128" x2="227" y2="128" stroke="#6366f1" stroke-width="1.3"/>
      <line x1="70" y1="143" x2="227" y2="143" stroke="#6366f1" stroke-width="1.3"/>
      <!-- Horizontal rules (limbic zone) -->
      <line x1="72" y1="170" x2="226" y2="170" stroke="#8b5cf6" stroke-width="1.3"/>
      <line x1="72" y1="185" x2="226" y2="185" stroke="#8b5cf6" stroke-width="1.3"/>
      <line x1="72" y1="200" x2="226" y2="200" stroke="#8b5cf6" stroke-width="1.3"/>
      <!-- Horizontal rules (reptilian zone) -->
      <line x1="74" y1="220" x2="225" y2="220" stroke="#10b981" stroke-width="1.3"/>
      <line x1="74" y1="235" x2="225" y2="235" stroke="#10b981" stroke-width="1.3"/>
      <line x1="74" y1="250" x2="225" y2="250" stroke="#10b981" stroke-width="1.3"/>
      <!-- Vertical cross-hatch (grid feel) -->
      <line x1="108" y1="100" x2="108" y2="282" stroke="#6366f1" stroke-width="0.6" opacity="0.35"/>
      <line x1="135" y1="97"  x2="135" y2="284" stroke="#6366f1" stroke-width="0.6" opacity="0.35"/>
      <line x1="163" y1="100" x2="163" y2="282" stroke="#6366f1" stroke-width="0.6" opacity="0.35"/>
      <line x1="190" y1="103" x2="190" y2="279" stroke="#6366f1" stroke-width="0.6" opacity="0.35"/>
    </g>

    <!-- Layer boundary dashes -->
    <g filter="url(#sk)" opacity="0.42">
      <line x1="66" y1="160" x2="232" y2="160" stroke="#6366f1" stroke-width="1.1" stroke-dasharray="5,3"/>
      <line x1="66" y1="210" x2="232" y2="210" stroke="#10b981" stroke-width="1.1" stroke-dasharray="5,3"/>
    </g>
  </g>

  <!-- Brain outline — left (sketchy) -->
  <g filter="url(#sk)">
    <ellipse cx="150" cy="190" rx="85" ry="95"
             stroke="#1e293b" stroke-width="3.2"/>
    <!-- Gyri at crown -->
    <path d="M112,110 Q132,100 152,108" stroke="#4338ca" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
    <path d="M152,105 Q172,97 188,108"  stroke="#4338ca" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
    <!-- Brain stem -->
    <path d="M140,284 Q150,296 160,284" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
  </g>

  <!-- "Conscious" label above brain -->
  <g filter="url(#sk2)">
    <text x="150" y="72" text-anchor="middle"
          font-family="Caveat, cursive" font-size="26" font-weight="700"
          fill="#4338ca" letter-spacing="1">Conscious</text>
    <text x="150" y="46" text-anchor="middle"
          font-family="Caveat, cursive" font-size="18" font-weight="500"
          fill="#6366f1" opacity="0.75">System 2 — Deliberate</text>
  </g>

  <!-- Speed/time label below left brain -->
  <g filter="url(#sk2)">
    <text x="150" y="320" text-anchor="middle"
          font-family="'Noto Sans', sans-serif" font-size="28" font-weight="700"
          fill="#1e293b">8.34 s</text>
    <text x="150" y="344" text-anchor="middle"
          font-family="'Noto Sans', sans-serif" font-size="13"
          fill="#64748b">per task step · VLM every call</text>
  </g>

  <!-- Small clock icon suggestion (drawn) -->
  <g filter="url(#sk)" opacity="0.6">
    <circle cx="150" cy="165" r="12" stroke="#6366f1" stroke-width="1.5"/>
    <line x1="150" y1="157" x2="150" y2="165" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="150" y1="165" x2="156" y2="168" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round"/>
  </g>


  <!-- ══════════════════════════════════════════════
       CENTER — TRANSFORMATION
       The C→S story: what happens between the two modes
       ══════════════════════════════════════════════ -->

  <!-- Main transformation arrow -->
  <g filter="url(#sk)">
    <!-- Arrow shaft -->
    <line x1="310" y1="190" x2="638" y2="190"
          stroke="#1e293b" stroke-width="4.5" stroke-linecap="round"/>
    <!-- Arrowhead -->
    <path d="M622,174 L650,190 L622,206"
          stroke="#1e293b" stroke-width="4.5" stroke-linecap="round"
          stroke-linejoin="round"/>
  </g>

  <!-- 3.83× speedup badge (prominent) -->
  <g filter="url(#sk2)">
    <!-- Badge background -->
    <rect x="398" y="152" width="164" height="52" rx="12"
          fill="#1e293b" opacity="0.92"/>
    <text x="480" y="175" text-anchor="middle"
          font-family="'Google Sans','Noto Sans',sans-serif"
          font-size="26" font-weight="700" fill="#ffffff">
      3.83× faster
    </text>
    <text x="480" y="196" text-anchor="middle"
          font-family="'Noto Sans',sans-serif"
          font-size="12" fill="#94a3b8">
      p &lt; 0.0001 · Cohen's d = 6.82
    </text>
  </g>

  <!-- Three architecture layer pills (stacked) -->
  <g filter="url(#sk2)">
    <!-- Semantic -->
    <rect x="415" y="218" width="130" height="30" rx="8" fill="#ede9fe"/>
    <text x="480" y="238" text-anchor="middle"
          font-family="'Noto Sans',sans-serif" font-size="12" font-weight="700"
          fill="#4338ca">Semantic · ~1 Hz · Neocortex</text>
    <!-- Episodic -->
    <rect x="415" y="254" width="130" height="30" rx="8" fill="#f3e8ff"/>
    <text x="480" y="274" text-anchor="middle"
          font-family="'Noto Sans',sans-serif" font-size="12" font-weight="700"
          fill="#7c3aed">Episodic · ~10 Hz · Limbic</text>
    <!-- Procedural -->
    <rect x="415" y="290" width="130" height="30" rx="8" fill="#d1fae5"/>
    <text x="480" y="310" text-anchor="middle"
          font-family="'Noto Sans',sans-serif" font-size="12" font-weight="700"
          fill="#065f46">Procedural · ~50 Hz · Basal Ganglia</text>
  </g>

  <!-- "~40 episodes" annotation -->
  <g filter="url(#sk2)">
    <text x="480" y="336" text-anchor="middle"
          font-family="Caveat, cursive" font-size="17"
          fill="#64748b">after ~40 episodes of practice</text>
    <!-- Small arrow pointing up to the stack -->
    <path d="M480,325 L480,318" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
  </g>

  <!-- Novelty threshold label -->
  <g filter="url(#sk2)">
    <text x="480" y="138" text-anchor="middle"
          font-family="Caveat, cursive" font-size="16"
          fill="#94a3b8">Novelty gate θ = 0.7</text>
  </g>


  <!-- ══════════════════════════════════════════════
       RIGHT SIDE — SUBCONSCIOUS (S)
       Three color zones + flowing WAVES
       = automatic, effortless execution
       ══════════════════════════════════════════════ -->

  <!-- Three brain-layer color zones, masked to ellipse -->
  <g mask="url(#br)">
    <rect x="725" y="95"  width="170" height="65"  fill="#ede9fe"/>
    <rect x="725" y="160" width="170" height="50"  fill="#f3e8ff"/>
    <rect x="725" y="210" width="170" height="80"  fill="#d1fae5"/>

    <!-- FLOWING SINE WAVES — represents automatic execution -->
    <g filter="url(#sk)" opacity="0.78">
      <!-- Neocortex zone waves -->
      <path d="M728,113 Q740,106 752,113 Q764,120 776,113 Q788,106 800,113 Q812,120 824,113"
            stroke="#6366f1" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M728,128 Q740,121 753,128 Q766,135 778,128 Q790,121 803,128 Q815,135 826,128"
            stroke="#6366f1" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M728,144 Q741,137 754,144 Q767,151 779,144 Q791,137 804,144 Q817,151 828,144"
            stroke="#6366f1" stroke-width="1.6" stroke-linecap="round"/>
      <!-- Limbic zone waves -->
      <path d="M729,170 Q742,163 755,170 Q768,177 780,170 Q792,163 805,170 Q818,177 828,170"
            stroke="#8b5cf6" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M729,185 Q742,178 755,185 Q768,192 780,185 Q793,178 806,185 Q819,192 828,185"
            stroke="#8b5cf6" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M729,200 Q742,193 756,200 Q769,207 781,200 Q793,193 806,200 Q819,207 828,200"
            stroke="#8b5cf6" stroke-width="1.6" stroke-linecap="round"/>
      <!-- Reptilian zone waves -->
      <path d="M730,220 Q743,213 756,220 Q769,227 781,220 Q793,213 806,220 Q819,227 828,220"
            stroke="#10b981" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M730,235 Q743,228 756,235 Q769,242 781,235 Q793,228 806,235 Q819,242 828,235"
            stroke="#10b981" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M730,250 Q743,243 757,250 Q770,257 782,250 Q794,243 807,250 Q820,257 829,250"
            stroke="#10b981" stroke-width="1.6" stroke-linecap="round"/>
    </g>

    <!-- Layer boundary dashes -->
    <g filter="url(#sk)" opacity="0.42">
      <line x1="726" y1="160" x2="892" y2="160" stroke="#6366f1" stroke-width="1.1" stroke-dasharray="5,3"/>
      <line x1="726" y1="210" x2="892" y2="210" stroke="#10b981" stroke-width="1.1" stroke-dasharray="5,3"/>
    </g>
  </g>

  <!-- Brain outline — right (sketchy) -->
  <g filter="url(#sk)">
    <ellipse cx="810" cy="190" rx="85" ry="95"
             stroke="#1e293b" stroke-width="3.2"/>
    <!-- Gyri at crown -->
    <path d="M772,110 Q792,100 812,108" stroke="#4338ca" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
    <path d="M812,105 Q832,97 848,108"  stroke="#4338ca" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
    <!-- Brain stem -->
    <path d="M800,284 Q810,296 820,284" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
  </g>

  <!-- "Subconscious" label above brain -->
  <g filter="url(#sk2)">
    <text x="810" y="72" text-anchor="middle"
          font-family="Caveat, cursive" font-size="26" font-weight="700"
          fill="#059669" letter-spacing="1">Subconscious</text>
    <text x="810" y="46" text-anchor="middle"
          font-family="Caveat, cursive" font-size="18" font-weight="500"
          fill="#10b981" opacity="0.75">System 1 — Automatic</text>
  </g>

  <!-- Speed/time label below right brain -->
  <g filter="url(#sk2)">
    <text x="810" y="320" text-anchor="middle"
          font-family="'Noto Sans', sans-serif" font-size="28" font-weight="700"
          fill="#1e293b">2.18 s</text>
    <text x="810" y="344" text-anchor="middle"
          font-family="'Noto Sans', sans-serif" font-size="13"
          fill="#64748b">per task step · VLM bypassed</text>
  </g>

  <!-- Lightning bolt — fast/automatic indicator -->
  <g filter="url(#sk)" opacity="0.7">
    <path d="M818,158 L808,174 L815,174 L805,190" stroke="#10b981" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round"/>
  </g>

</svg>
